FROM python:3.12-slim

# Speculum collector: stdlib only, no pip packages.
# GPU comes from the host driver via nvidia-smi (container toolkit mount),
# never from a CUDA install inside this image.

WORKDIR /app

COPY collector/ ./collector/

# Non-root runtime user; /data holds the SQLite history DB (named volume).
RUN useradd -r -m -d /home/speculum speculum \
    && mkdir -p /data /app \
    && chown -R speculum:speculum /app /data /home/speculum

USER speculum

ENV XDG_DATA_HOME=/data \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

EXPOSE 8792

# Config: mount your speculum.toml at /app/speculum.toml
# (copy from aether.example.toml). Without it the collector probes
# localhost defaults and still serves.
CMD ["python3", "collector/aether.py"]
